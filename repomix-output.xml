"""The model contract. Any change to features or heights requires retraining."""
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MODEL_DIR = ROOT / 'models'
DATA_DIR = ROOT / 'data'
BOULDER_LAT, BOULDER_LON = 40.015, -105.2705
TIMEZONE = 'America/Denver'
MODEL_SOURCE = 'gfs_global'
MODEL_VERSION = 'gfs-run-fog-elevation-v2'
# The GFS Single Runs archive starts in April 2026; not the stitched historical archive.
ARCHIVE_START = '2026-04-02T00:00'
MAX_LEAD_HOURS = 72  # strict bound: 0 <= lead < 72 hours from run initialization
PRESSURE_LEVELS = (800, 750, 700, 650, 600)
PROFILE_CHANNELS = ('temperature_c', 'relative_humidity_pct', 'u_wind_ms', 'v_wind_ms', 'pressure_cloud_pct')
PROFILE_LEVELS = 25
PROFILE_TOP_AGL_M = 2000
LANDMARKS_FT = {'Boulder': 5400, 'First Flatiron': 7200, 'Green Mountain': 8100}
# KBDU airport lies outside downtown Boulder and may have different fog conditions.
OBS_STATION, OBS_NETWORK = 'BDU', 'CO_ASOS'
OBS_STATION_ELEV_FT = 5288  # KBDU published airport elevation; geographically distinct from downtown Boulder
SURFACE_FIELDS = (
    'temperature_2m', 'dew_point_2m', 'relative_humidity_2m',
    'cloud_cover_low', 'cloud_cover_mid', 'cloud_cover_high',
    'wind_speed_10m', 'wind_direction_10m',
    'visibility', 'weather_code',
)
OPTIONAL_FIELDS = ('boundary_layer_height',)
PROFILE_FIELDS = tuple(
    f'{kind}_{p}hPa'
    for p in PRESSURE_LEVELS
    for kind in ('temperature', 'relative_humidity', 'cloud_cover',
                 'wind_speed', 'wind_direction', 'geopotential_height')
)
HOURLY_FIELDS = SURFACE_FIELDS + OPTIONAL_FIELDS + PROFILE_FIELDS
FEATURE_NAMES = (
    'temperature_2m', 'dewpoint_depression', 'relative_humidity_2m',
    'low_cloud_pct', 'mid_cloud_pct', 'high_cloud_pct',
    'forecast_visibility_log_m', 'forecast_pbl_height_m',
    'forecast_fog_weather_code', 'pressure_cloud_300m', 'pressure_cloud_750m',
    'wind_u_10m_ms', 'wind_v_10m_ms',
    't_delta_300m', 't_delta_750m', 'rh_300m', 'rh_750m',
    'wind_u_300m_ms', 'wind_v_300m_ms',
