    <!-- Horizontal HRRR transect. Coordinate diagram not a terrain basemap. -->
    <section class="glass-card rounded-3xl p-5 sm:p-6 space-y-4" id="foothillsTransect" aria-label="HRRR geographic transect between Boulder and the Flatirons">
