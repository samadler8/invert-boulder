"""Shared train/serve transformation of initialized forecasts into rows."""
from datetime import datetime, timezone
from zoneinfo import ZoneInfo
import math
import numpy as np

from .config import (FEATURE_NAMES, PRESSURE_LEVELS, PROFILE_LEVELS,
                     PROFILE_TOP_AGL_M, SURFACE_FIELDS, PROFILE_FIELDS,
                     TIMEZONE, MAX_LEAD_HOURS)


def utcparse(s):
    dt = datetime.fromisoformat(s.replace('Z', '+00:00'))
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)  # Open-Meteo times requested as UTC
    return dt.astimezone(timezone.utc)


def uv(speed_kmh, bearing_deg):
    angle = math.radians(float(bearing_deg))
    speed = float(speed_kmh) / 3.6
    return -speed * math.sin(angle), -speed * math.cos(angle)


def row_at(data, i):
    """None if missing/out-of-horizon; no guessed fields or zero-imputation."""
    h = data.get('hourly', {})
    try:
        init = utcparse(data['_run_utc'])
        timestamp = utcparse(h['time'][i])
        lead = (timestamp - init).total_seconds() / 3600
        if not 0 <= lead < MAX_LEAD_HOURS:
            return None
        values = {k: float(h[k][i]) for k in SURFACE_FIELDS + PROFILE_FIELDS}
        if not all(np.isfinite(v) for v in values.values()):
            return None
        # Some GFS sub-products omit boundary-layer height; XGBoost handles NaN.
        pbl = h.get('boundary_layer_height', [None] * len(h['time']))[i]
        pbl = float(pbl) if pbl is not None else float('nan')
        local = timestamp.astimezone(ZoneInfo(TIMEZONE))
        z_ground = float(data['elevation'])
        z_surface = z_ground + 2
        zs = [z_surface]
        t = [values['temperature_2m']]
        rh = [values['relative_humidity_2m']]
        u0, v0 = uv(values['wind_speed_10m'], values['wind_direction_10m'])
        u, v = [u0], [v0]
        # Cloud cover at ground is NOT a pressure-level measurement.
        cp_z, cp_values = [], []
        for p in PRESSURE_LEVELS:
            z = values[f'geopotential_height_{p}hPa']
            if z < z_surface + 5:
                continue
            up, vp = uv(values[f'wind_speed_{p}hPa'], values[f'wind_direction_{p}hPa'])
            zs.append(z)
            t.append(values[f'temperature_{p}hPa'])
            rh.append(values[f'relative_humidity_{p}hPa'])
            u.append(up)
            v.append(vp)
            cp_z.append(z)
            cp_values.append(values[f'cloud_cover_{p}hPa'])
        order = np.argsort(zs)
        heights = np.asarray(zs)[order]
        if len(heights) < 4 or heights[-1] < z_surface + PROFILE_TOP_AGL_M:
            return None
        if np.any(np.diff(heights) < 1):
            return None
        if len(cp_z) < 2:
            return None
        def interp(channel, height):
            return float(np.interp(height, heights, np.asarray(channel)[order]))
        grid = np.linspace(z_surface, z_surface + PROFILE_TOP_AGL_M,
                           PROFILE_LEVELS, dtype=np.float32)
        profile = np.stack([
            *[np.interp(grid, heights, np.asarray(ch)[order]) for ch in (t, rh, u, v)],
            np.interp(grid, cp_z, cp_values),
        ]).astype(np.float32)
        # Boundary held constant only for below-first-pressure-level cloud cover;
        # this is model interpolation, not new independent observations.
        cp300 = float(np.interp(z_surface + 300, cp_z, cp_values))
        cp750 = float(np.interp(z_surface + 750, cp_z, cp_values))
        year_phase = 2 * math.pi * (local.timetuple().tm_yday / 365.25)
        hour_phase = 2 * math.pi * (local.hour / 24)
        features = np.asarray([
            values['temperature_2m'], values['temperature_2m'] - values['dew_point_2m'],
            values['relative_humidity_2m'],
            values['cloud_cover_low'], values['cloud_cover_mid'], values['cloud_cover_high'],
            math.log1p(max(0.0, values['visibility'])),
            pbl,
            float(int(values['weather_code']) in (45, 48)),
            cp300, cp750, u0, v0,
            interp(t, z_surface + 300) - t[0],
            interp(t, z_surface + 750) - t[0],
            interp(rh, z_surface + 300), interp(rh, z_surface + 750),
            interp(u, z_surface + 300), interp(v, z_surface + 300),
            lead, math.sin(hour_phase), math.cos(hour_phase),
            math.sin(year_phase), math.cos(year_phase),
        ], dtype=np.float32)
        assert len(features) == len(FEATURE_NAMES)
        return {
            'timestamp': timestamp.isoformat().replace('+00:00', 'Z'),
            'run_utc': init.isoformat().replace('+00:00', 'Z'),
            'lead_hours': lead,
            'local_time': local.isoformat(),
            'features': features,
            'profile': profile,
            'observables': {
                'lowClouds': values['cloud_cover_low'],
                'midClouds': values['cloud_cover_mid'],
                'highClouds': values['cloud_cover_high'],
                'surfTemp': values['temperature_2m'],
                'dewPoint': values['dew_point_2m'],
                'rh': values['relative_humidity_2m'],
                'tempDelta': interp(t, z_surface + 300) - t[0],
                'windSpeed': values['wind_speed_10m'] / 1.609344,
                'windDir': values['wind_direction_10m'],
                'forecast_visibility_m': values['visibility'],
                'forecast_boundary_layer_height_m': float(pbl) if np.isfinite(pbl) else None,
                'forecast_pressure_cloud_300m': cp300,
                'forecast_pressure_cloud_750m': cp750,
                'forecast_weather_code': int(values['weather_code']),
            },
        }
    except (ValueError, KeyError, IndexError, TypeError, AssertionError):
        return None


def rows_from_data(response):
    return [r for i in range(len(response.get('hourly', {}).get('time', [])))
            if (r := row_at(response, i)) is not None]
