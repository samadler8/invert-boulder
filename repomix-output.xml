"""Local web inference server. Requires saved observation-trained artifacts."""
from datetime import datetime, timezone
from pathlib import Path
import threading
import time

from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from .config import ROOT, MODEL_DIR, MAX_LEAD_HOURS
from .features import rows_from_data, utcparse
from .weather import latest_available_run
from .predict import Predictor

app = FastAPI(title='Boulder Short-Range Fog & Inversion Predictor', version='2.0.0')
_lock = threading.RLock()
_cache = {'at': 0.0, 'data': None, 'stamp': None}
_loaded = {'stamp': None, 'predictor': None}


def load_predictor():
    path = MODEL_DIR / 'manifest.json'
    if not path.exists():
        raise HTTPException(503, 'Observation-trained model not found. Download METAR labels and train first; see README.')
    with _lock:
        stamp = path.stat().st_mtime_ns
        if _loaded['stamp'] == stamp and _loaded['predictor'] is not None:
            return _loaded['predictor']
        try:
            model = Predictor(MODEL_DIR)
        except (ValueError, RuntimeError, FileNotFoundError, KeyError) as exc:
            raise HTTPException(503, f'Cannot load trained models: {exc}') from exc
        _loaded.update(stamp=stamp, predictor=model)
        return model


@app.get('/')
def index():
    return FileResponse(ROOT / 'index.html')


@app.get('/{name}')
def site_file(name: str):
    if name not in ('guide.html', 'science.html', 'dashboard.js'):
        raise HTTPException(404, 'Not found')
    return FileResponse(ROOT / name)


@app.get('/api/health')
def health():
    return {'status': 'ok', 'trained_models_available': (MODEL_DIR / 'manifest.json').exists(),
            'forecast_horizon_hours_exclusive': MAX_LEAD_HOURS}


@app.get('/api/forecast')
def forecast(refresh: bool = False):
    predictor = load_predictor()
    with _lock:
        stamp = _loaded['stamp']
        if (not refresh and _cache['data'] is not None
                and time.monotonic() - _cache['at'] < 1800
                and _cache['stamp'] == stamp):
            return _cache['data']
    now = datetime.now(timezone.utc)
    try:
        data = latest_available_run(now=now)
        issue = utcparse(data['_run_utc'])
        rows = [r for r in rows_from_data(data)
                if now <= utcparse(r['timestamp']) and 0 <= r['lead_hours'] < MAX_LEAD_HOURS]
    except (ValueError, RuntimeError) as exc:
        raise HTTPException(502, f'Initialized GFS forecast acquisition failed: {exc}') from exc
    if len(rows) < 8:
        raise HTTPException(502, 'Less than 8 complete GFS hours available for this initialized run.')
    result = {
        'source': 'Open-Meteo GFS Single Runs (explicit 6-hour-cycle forecast issue time)',
        'forecast_run_utc': issue.isoformat(),
        'fetched_at_utc': now.isoformat(),
        'model': {
            'target': predictor.manifest['target'],
            'verified_observations': predictor.manifest['verified_observations'],
            'warning': predictor.manifest['disclaimer'],
            'test_metrics': predictor.manifest['test_metrics'],
            'cloud_base_available': predictor.manifest['cloud_base']['available'],
            'scenic_available': predictor.manifest['scenic']['available'],
            'max_lead_hours_exclusive': MAX_LEAD_HOURS,
        },
        'hours': predictor.predict(rows),
    }
    with _lock:
        _cache.update(at=time.monotonic(), data=result, stamp=stamp)
    return result
