          <i class="fa-solid fa-mountain-sun text-slate-950 text-xl font-bold"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
              Boulder Inversion Tracker
            </h1>
            <span class="text-[10px] bg-cyan-950 text-cyan-400 border border-cyan-800/60 font-semibold px-2 py-0.5 rounded-full uppercase tracking-wider">
              Illustrative 3-Level Profile
            </span>
          </div>
          <p class="text-xs text-slate-400 flex items-center space-x-1.5">
