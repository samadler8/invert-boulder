"""Train on issued GFS runs aligned to independent METAR station labels.

Usage: python -m inversion.train --start 2026-05-01 --end 2026-10-01 \
 --observations data/observed_bdu.csv

Optional manually verified landmark labels enable direct scenic-event model:
  timestamp,target_elevation_ft,observed_summit_clear
  2026-09-01T12:00:00Z,8100,1
Do NOT infer summit-clear labels from airport cloud bases.
"""
import argparse
import csv
import json
import math
from datetime import date, datetime, time, timezone, timedelta
from pathlib import Path

import numpy as np
import torch
from sklearn.metrics import mean_absolute_error
from xgboost import XGBRegressor

from .config import (DATA_DIR, MODEL_DIR, FEATURE_NAMES, SCENIC_FEATURE_NAMES,
                     PROFILE_CHANNELS, PROFILE_LEVELS, PROFILE_TOP_AGL_M,
                     MODEL_VERSION, MODEL_SOURCE, MAX_LEAD_HOURS, ARCHIVE_START)
from .features import rows_from_data
from .weather import fetch_archive
from .observations import read_csv
from .models import (train_xgb, train_cnn, raw_cnn, platt_fit,
                     platt_apply, metrics)


def unique_rows(responses):
    """Multiple forecast issuances predict the same future valid hour.

    DO NOT deduplicate by valid timestamp: lead time is a model input.
    """
    unique = {}
    for data in responses:
        for r in rows_from_data(data):
            unique[(r['timestamp'], r['run_utc'])] = r
    return sorted(unique.values(), key=lambda x: (x['timestamp'], x['run_utc']))


def split_chronological(pairs, *, gap_hours=MAX_LEAD_HOURS, minimum=150, binary=True):
    """Order by valid time and purge a >=forecast-horizon gap from val/test.

    This keeps different model runs verifying at the SAME hour in one partition.
    If a user only supplies sparse observations, detect too little data rather
    than silently permit leakage. Repeated outcomes within a split are allowed.
    """
    if len(pairs) < minimum:
        raise ValueError(f'Need at least {minimum} usable labeled examples; got {len(pairs)}')
    times = sorted({p[0]['timestamp'] for p in pairs})
    if len(times) < 30:
        raise ValueError('Need at least 30 different observed valid hours')
    cutoff1 = times[int(len(times) * .70)]
    cutoff2 = times[int(len(times) * .85)]
    d1 = datetime.fromisoformat(cutoff1.replace('Z', '+00:00'))
    d2 = datetime.fromisoformat(cutoff2.replace('Z', '+00:00'))
    delta = timedelta(hours=gap_hours)
    dt = lambda r: datetime.fromisoformat(r[0]['timestamp'].replace('Z', '+00:00'))
    tr = [pair for pair in pairs if dt(pair) < d1 - delta]
    va = [pair for pair in pairs if d1 <= dt(pair) < d2 - delta]
    te = [pair for pair in pairs if dt(pair) >= d2]
    if min(len(tr), len(va), len(te)) < 10:
        raise ValueError('Not enough independent examples after 72-hour split purge')
    if binary:
        for name, split in [('train', tr), ('validation', va), ('test', te)]:
            if len({int(y) for _, y in split}) < 2:
                raise ValueError(f'{name} has only one class; collect a longer period/real events')
    return tr, va, te


def arrays(part):
    return (
        np.stack([r['features'] for r, _ in part]),
        np.stack([r['profile'] for r, _ in part]),
        np.asarray([y for _, y in part], dtype=np.int64),
    )


def summarize_split(trainset, valset, testset):
    return {
        'training_rows': len(trainset), 'validation_rows': len(valset),
        'test_rows': len(testset),
        'train_valid_time_span_utc': [trainset[0][0]['timestamp'], trainset[-1][0]['timestamp']],
        'test_valid_time_span_utc': [testset[0][0]['timestamp'], testset[-1][0]['timestamp']],
    }


def read_summit_labels(path):
    """Only human-verified observations; never fabricate summit visibility."""
    result = []
    with open(path, newline='') as f:
        for raw in csv.DictReader(f):
            d = datetime.fromisoformat(raw['timestamp'].replace('Z', '+00:00'))
            if d.tzinfo is None:
                raise ValueError('Summit timestamps must include UTC offset or Z')
            key = d.astimezone(timezone.utc).replace(minute=0, second=0, microsecond=0).isoformat().replace('+00:00', 'Z')
            z = float(raw['target_elevation_ft'])
            clear = int(raw['observed_summit_clear'])
            if clear not in (0, 1) or not 5400 <= z <= 11000:
                raise ValueError('Summit clear must be 0/1 and altitude 5400..11000 ft')
            result.append((key, z, clear))
    if len(set((t, z) for t, z, _ in result)) != len(result):
        raise ValueError('Duplicate summit target hour/elevation')
    return result


def fit_cloud_base(rows, observations, directory, *, min_rows=100):
    """Optional conditional cloud BASE regression, NOT a cloud TOP predictor."""
    examples = [(r, observations[r['timestamp']]['cloud_base_ft'])
                for r in rows if r['timestamp'] in observations
                and observations[r['timestamp']]['cloud_base_ft'] is not None]
    if len(examples) < min_rows:
        return {'available': False, 'reason': f'Only {len(examples)} reported low cloud bases (minimum {min_rows}).'}
    try:
        tr, va, te = split_chronological(examples, minimum=min_rows, binary=False)
    except ValueError as e:
        return {'available': False, 'reason': str(e)}
    xtr = np.stack([r['features'] for r, _ in tr])
    xva = np.stack([r['features'] for r, _ in va])
    xte = np.stack([r['features'] for r, _ in te])
    ytr = np.asarray([v for _, v in tr], dtype=float)
    yva = np.asarray([v for _, v in va], dtype=float)
    yte = np.asarray([v for _, v in te], dtype=float)
    reg = XGBRegressor(n_estimators=180, max_depth=3, learning_rate=.04,
                       subsample=.85, colsample_bytree=.9, tree_method='hist',
                       n_jobs=4, random_state=42, objective='reg:squarederror')
    reg.fit(xtr, ytr, verbose=False)
    residual = np.abs(reg.predict(xva) - yva)
    # Marginal validation 80% absolute residual band, not a true conditional interval.
    margin = float(np.quantile(residual, .8))
    residual_sigma = max(50.0, float(np.std(reg.predict(xva) - yva)))
    mae = float(mean_absolute_error(yte, reg.predict(xte)))
    reg.save_model(str(directory / 'cloud_base.json'))
    return {'available': True, 'target': 'METAR BKN/OVC/VV low cloud BASE ft MSL (not cloud top)',
            'validation_80pct_abs_residual_ft': round(margin, 1),
            'validation_residual_sigma_ft': round(residual_sigma, 1),
            'test_mae_ft': round(mae, 1), 'split': summarize_split(tr, va, te),
            'warning': 'Only predicts a reported cloud base near KBDU when a low ceiling is reported; cannot infer summit clearance.'}


def fit_scenic(rows, observations, labels, directory, *, min_rows=150):
    """Optional elevation-conditioned classifier for independently labeled scenic event."""
    if not labels:
        return {'available': False, 'reason': 'No independently observed summit-clear labels supplied.'}
    weather_by_valid = {}
    for row in rows:
        weather_by_valid.setdefault(row['timestamp'], []).append(row)
    samples = []
    for timestamp, elevation, summit_clear in labels:
        station = observations.get(timestamp)
        if not station or station['fog'] is None:
            continue  # Cannot infer a negative from unknown fog.
        target = int(station['fog'] == 1 and summit_clear == 1)
        for row in weather_by_valid.get(timestamp, []):
            newrow = {**row, 'scenic_features': np.append(row['features'], elevation).astype(np.float32)}
            samples.append((newrow, target))
    if len(samples) < min_rows:
        return {'available': False, 'reason': f'Only {len(samples)} independently labeled scenic examples (minimum {min_rows}).'}
    try:
        tr, va, te = split_chronological(samples, minimum=min_rows)
    except ValueError as e:
        return {'available': False, 'reason': str(e)}
    xa = lambda part: np.stack([r['scenic_features'] for r, _ in part])
    ya = lambda part: np.asarray([y for _, y in part])
    model = train_xgb(xa(tr), ya(tr), xa(va), ya(va))
    cal = platt_fit(model.predict_proba(xa(va))[:, 1], ya(va))
    report = metrics(ya(te), platt_apply(model.predict_proba(xa(te))[:, 1], cal))
    model.save_model(str(directory / 'scenic.json'))
    # Only publish altitudes with at least 30 independent annotated valid times.
    unique_per_alt = {float(z): {t for t, z0, _ in labels if z0 == z} for _, z, _ in labels}
    trained_elevations = sorted(z for z, times in unique_per_alt.items() if len(times) >= 30)
    return {'available': True, 'trained_elevations_ft': trained_elevations,
            'target': 'Observed Boulder fog AND independently observed summit clear',
            'features': list(SCENIC_FEATURE_NAMES), 'calibration': cal,
            'test_metrics': report, 'split': summarize_split(tr, va, te),
            'warning': 'Summit-clear observations must be independently audited; altitude interpolation is not validated.'}


def train(responses, *, observations, scenic_labels=None, model_dir=MODEL_DIR,
          cnn_epochs=25, xgb_estimators=300, min_rows=150):
    """Fail closed: independent labels required. No synthetic/proxy training mode."""
    if not observations:
        raise ValueError('Independent METAR observations are required')
    rows = unique_rows(responses)
    if not rows:
        raise ValueError('No usable GFS profiles with valid issue times and 0-72h leads')
    labeled = [(r, observations[r['timestamp']]['fog']) for r in rows
               if r['timestamp'] in observations and observations[r['timestamp']]['fog'] is not None]
    tr, va, te = split_chronological(labeled, minimum=min_rows)
    xtr, ptr, ytr = arrays(tr)
    xva, pva, yva = arrays(va)
    xte, pte, yte = arrays(te)
    xgb = train_xgb(xtr, ytr, xva, yva, estimators=xgb_estimators)
    cnn, mean, scale, cnn_info = train_cnn(ptr, ytr, pva, yva, epochs=cnn_epochs)
    xgb_cal = platt_fit(xgb.predict_proba(xva)[:, 1], yva)
    cnn_cal = platt_fit(raw_cnn(cnn, pva, mean, scale), yva)
    xprobs = platt_apply(xgb.predict_proba(xte)[:, 1], xgb_cal)
    cprobs = platt_apply(raw_cnn(cnn, pte, mean, scale), cnn_cal)
    ensemble = (xprobs + cprobs) / 2
    report = {'xgb': metrics(yte, xprobs), 'cnn': metrics(yte, cprobs),
              'ensemble': metrics(yte, ensemble)}
    by_lead = {}
    for lo, hi in ((0, 24), (24, 48), (48, 72)):
        mask = np.asarray([lo <= r['lead_hours'] < hi for r, _ in te], dtype=bool)
        if mask.any():
            by_lead[f'{lo}-{hi}h'] = {'n': int(mask.sum()), **metrics(yte[mask], ensemble[mask])}
    # A simple forecast-only categorical baseline (not itself calibrated).
    raw_forecast_flags = np.asarray([
        int(r['observables']['forecast_visibility_m'] <= 1609) for r, _ in te
    ], dtype=np.float32)
    report['raw_gfs_visibility_threshold'] = metrics(yte, raw_forecast_flags)
    model_dir = Path(model_dir)
    model_dir.mkdir(parents=True, exist_ok=True)
    xgb.save_model(str(model_dir / 'xgb.json'))
    torch.save({'state_dict': cnn.state_dict(),
                'mean': torch.tensor(mean), 'scale': torch.tensor(scale)},
               str(model_dir / 'cnn.pt'))
    base_meta = fit_cloud_base(rows, observations, model_dir, min_rows=100)
    scenic_meta = fit_scenic(rows, observations, scenic_labels, model_dir, min_rows=min_rows)
    # Remove stale optional models when retraining cannot support them.
    for ok, name in [(base_meta['available'], 'cloud_base.json'),
                     (scenic_meta['available'], 'scenic.json')]:
        if not ok:
            (model_dir / name).unlink(missing_ok=True)
    manifest = {
        'version': MODEL_VERSION, 'data_model': MODEL_SOURCE,
        'target': 'observed_airport_fog', 'verified_observations': True,
        'observation_station': 'KBDU / Boulder Municipal Airport',
        'max_lead_hours_exclusive': MAX_LEAD_HOURS,
        'weather_archive': 'Open-Meteo GFS Single Runs (issue-time preserving)',
        'disclaimer': ('METAR-based fog predictions at Boulder Municipal Airport; not thermodynamic '
                       'inversion measurements or proven mountain cloud-sea probabilities. '
                       'Historical forecast availability and independent event frequency limit accuracy.'),
        'features': list(FEATURE_NAMES), 'channels': list(PROFILE_CHANNELS),
        'profile_levels': PROFILE_LEVELS, 'profile_top_agl_m': PROFILE_TOP_AGL_M,
        **summarize_split(tr, va, te),
        'test_metrics': report, 'test_metrics_by_lead': by_lead,
        'calibration': {'xgb': xgb_cal, 'cnn': cnn_cal},
        'cnn_training': cnn_info, 'cloud_base': base_meta, 'scenic': scenic_meta,
    }
    (model_dir / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    return manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--start', type=date.fromisoformat, required=True,
                        help='First historical GFS run UTC date (>=2026-04-02)')
    parser.add_argument('--end', type=date.fromisoformat, required=True,
                        help='Last historical GFS run UTC date (no future dates)')
    parser.add_argument('--observations', type=Path, required=True,
                        help='CSV generated with python -m inversion.observations')
    parser.add_argument('--summit-labels', type=Path,
                        help='Optional human-labeled summit_clear CSV with elevation')
    parser.add_argument('--run-every-hours', type=int, choices=[6, 12, 24], default=24)
    parser.add_argument('--history-json', type=Path, help='Offline run-shaped JSON fixtures')
    parser.add_argument('--epochs', type=int, default=25)
    parser.add_argument('--model-dir', type=Path, default=MODEL_DIR)
    args = parser.parse_args()
    if args.history_json:
        responses = json.loads(args.history_json.read_text())
        responses = responses if isinstance(responses, list) else [responses]
    else:
        start = datetime.combine(args.start, time(0), timezone.utc)
        end = datetime.combine(args.end, time(0), timezone.utc)
        if start < datetime.fromisoformat(ARCHIVE_START).replace(tzinfo=timezone.utc):
            parser.error(f'GFS single run archive begins {ARCHIVE_START} UTC')
        if end > datetime.now(timezone.utc) - timedelta(days=3):
            parser.error('Training runs must be at least 3 days old to have completed verification observations')
        responses = fetch_archive(start, end, run_every_hours=args.run_every_hours,
                                  cache_dir=DATA_DIR / 'gfs_runs')
    result = train(responses, observations=read_csv(args.observations),
                   scenic_labels=read_summit_labels(args.summit_labels) if args.summit_labels else None,
                   model_dir=args.model_dir, cnn_epochs=args.epochs)
    print(json.dumps(result, indent=2))


if __name__ == '__main__':
    main()
