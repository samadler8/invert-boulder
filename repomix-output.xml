"""Issue-time-preserving GFS forecast collection. Never train from stitched hindsight."""
import json
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

import requests
from .config import (BOULDER_LAT, BOULDER_LON, HOURLY_FIELDS,
                     MODEL_SOURCE, MAX_LEAD_HOURS, ARCHIVE_START)

RUN_URL = 'https://single-runs-api.open-meteo.com/v1/forecast'


def utc(dt):
    if dt.tzinfo is None:
        raise ValueError('Run initialization requires an explicit timezone')
    return dt.astimezone(timezone.utc)


def run_params(initialization):
    init = utc(initialization)
    return {
        'latitude': BOULDER_LAT, 'longitude': BOULDER_LON,
        'models': MODEL_SOURCE, 'hourly': ','.join(HOURLY_FIELDS),
        'timezone': 'UTC', 'temperature_unit': 'celsius',
        'wind_speed_unit': 'kmh', 'forecast_hours': MAX_LEAD_HOURS,
        'run': init.strftime('%Y-%m-%dT%H:%M'),
    }


def fetch_run(initialization, *, session=None, cache_dir=None):
    """Fetch an immutable, uniquely initialized run and cache raw JSON."""
    init = utc(initialization)
    if init < datetime.fromisoformat(ARCHIVE_START).replace(tzinfo=timezone.utc):
        raise ValueError(f'GFS single-run archive does not reach {init.isoformat()}; starts {ARCHIVE_START} UTC')
    cache_path = None
    if cache_dir is not None:
        cache = Path(cache_dir)
        cache.mkdir(parents=True, exist_ok=True)
        cache_path = cache / f'gfs_global_{init:%Y%m%dT%H%MZ}_v2.json'
        if cache_path.exists():
            data = json.loads(cache_path.read_text())
            if data.get('_run_utc') != init.isoformat():
                raise ValueError('Cached run has incorrect initialization')
            return data
    client = session if session is not None else requests
    last_error = None
    for attempt in range(3):
        try:
            response = client.get(RUN_URL, params=run_params(init), timeout=70)
            response.raise_for_status()
            data = response.json()
            if not isinstance(data.get('hourly'), dict) or not data['hourly'].get('time'):
                raise ValueError(f'No hourly data in GFS run: {str(data)[:180]}')
            data['_run_utc'] = init.isoformat()
            data['_forecast_model'] = MODEL_SOURCE
            if cache_path:
                cache_path.write_text(json.dumps(data))
            return data
        except (requests.RequestException, ValueError) as exc:
            last_error = exc
            if attempt < 2:
                time.sleep(attempt + 1)
    raise RuntimeError(f'Cannot fetch GFS run {init.isoformat()}: {last_error}') from last_error


def run_times(start, end, *, run_every_hours=24):
    """Inclusive UTC run initialization range, e.g. 00Z daily or 00/12Z."""
    if run_every_hours not in (6, 12, 24):
        raise ValueError('run_every_hours must be 6, 12 or 24, aligned to 00Z')
    start, end = utc(start), utc(end)
    cursor = start.replace(hour=0, minute=0, second=0, microsecond=0)
    while cursor <= end:
        if cursor >= start:
            yield cursor
        cursor += timedelta(hours=run_every_hours)


def fetch_archive(start, end, *, run_every_hours=24, cache_dir=None, session=None):
    return [fetch_run(r, cache_dir=cache_dir, session=session)
            for r in run_times(start, end, run_every_hours=run_every_hours)]


def latest_available_run(*, now=None, session=None, cache_dir=None):
    """Try completed 6-hourly GFS runs; assume at least 7h dissemination lag.

    There is NO fallback to stitched forecasts: serving with different lead-time
    semantics would silently invalidate the model. API errors propagate.
    """
    now = utc(now or datetime.now(timezone.utc))
    candidate = (now - timedelta(hours=7)).replace(minute=0, second=0, microsecond=0)
    candidate = candidate.replace(hour=(candidate.hour // 6) * 6)
    errors = []
    for k in range(5):
        init = candidate - timedelta(hours=6 * k)
        try:
            return fetch_run(init, session=session, cache_dir=cache_dir)
        except (ValueError, RuntimeError) as exc:
            errors.append(str(exc))
    raise RuntimeError('No recent initialized GFS run available. ' + '; '.join(errors[-2:]))
