def test_api_without_models_and_offline_with_models(tmp_path,monkeypatch):
    from inversion import server
    monkeypatch.setattr(server,'MODEL_DIR',tmp_path)
    server._loaded.update(stamp=None,predictor=None)
    server._cache.update(at=0.0,data=None,stamp=None)
    client=TestClient(app)
    assert client.get('/').status_code == 200
    assert client.get('/dashboard.js').status_code == 200
    assert client.get('/api/health').json()['trained_models_available'] is False
    assert client.get('/api/forecast').status_code == 503
    runs,obs=fixture_data()
    train(runs, observations=obs, model_dir=tmp_path, cnn_epochs=1,xgb_estimators=20)
    now=datetime.now(timezone.utc)
    issue=(now-timedelta(hours=10)).replace(minute=0,second=0,microsecond=0)
    live=fake_run(issue)
    monkeypatch.setattr(server,'latest_available_run',lambda **kw: live)
    result=client.get('/api/forecast')
    assert result.status_code==200,result.text
    payload=result.json()
    assert payload['model']['scenic_available'] is False
    assert all(h['landmarks'][1]['scenic_probability'] is None for h in payload['hours'])
    assert len(payload['hours']) > 40
    assert all(0 <= h['lead_hours'] < 72 for h in payload['hours'])
    assert client.get('/api/forecast').json()==payload
