<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Science | Boulder Inversion Tracker</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            alpine: { 900: '#080c14', 800: '#0f172a', 700: '#1e293b', 600: '#334155', cyan: '#06b6d4' }
          },
