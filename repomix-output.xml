"""Offline reproducible contract tests; artificial observations are TEST FIXTURES."""
from datetime import datetime, timedelta, timezone
from pathlib import Path
import math
import json

import numpy as np
import pytest
from fastapi.testclient import TestClient

from inversion.config import HOURLY_FIELDS, PRESSURE_LEVELS, FEATURE_NAMES, MAX_LEAD_HOURS
from inversion.features import row_at, rows_from_data, uv
from inversion.observations import (parse_iem_csv, classify_report, observed_cloud_base_ft,
                                    save_csv, read_csv)
from inversion.weather import run_params, run_times
from inversion.train import train, unique_rows, split_chronological
from inversion.predict import Predictor
from inversion.server import app


def fake_run(issue, *, n=72):
    h = {'time': [(issue + timedelta(hours=i)).strftime('%Y-%m-%dT%H:%M') for i in range(n)]}
    for key in HOURLY_FIELDS:
        h[key] = []
    for i in range(n):
        timestamp = issue + timedelta(hours=i)
        fog = (timestamp.date().toordinal() % 5 == 0 and 3 <= timestamp.hour <= 17)
        surf = 6 + 7 * math.sin(i / 36)
        vals = {
            'temperature_2m': surf,
            'dew_point_2m': surf - (.6 if fog else 5),
            'relative_humidity_2m': 96 if fog else 58,
            'cloud_cover_low': 92 if fog else 17,
            'cloud_cover_mid': 10 if fog else 55,
            'cloud_cover_high': 12 if fog else 60,
            'visibility': 650 if fog else 18000,
            'boundary_layer_height': 140 if fog else 1250,
            'weather_code': 45 if fog else 1,
            'wind_speed_10m': 5 if fog else 20,
            'wind_direction_10m': 80 if fog else 270,
        }
        for p, height in zip(PRESSURE_LEVELS, [1950, 2420, 3000, 3500, 4200]):
            vals.update({
                f'temperature_{p}hPa': surf + (2 if fog else -2) - (height - 1950) * .004,
                f'relative_humidity_{p}hPa': 86 if fog else 45,
                f'cloud_cover_{p}hPa': 90 if fog and p >= 750 else 14,
                f'wind_speed_{p}hPa': 12,
                f'wind_direction_{p}hPa': 85,
                f'geopotential_height_{p}hPa': height,
            })
        for key in HOURLY_FIELDS:
            h[key].append(vals[key])
    return {'elevation':1640,'hourly':h,'_run_utc':issue.isoformat(),
            '_forecast_model':'gfs_global'}


def fixture_data(days=80):
    initial = datetime(2026,5,1,tzinfo=timezone.utc)
    runs = [fake_run(initial + timedelta(days=d)) for d in range(days)]
    observations = {}
    for d in range(days+3):
        for hour in range(24):
            at = initial + timedelta(days=d,hours=hour)
            label = int(at.date().toordinal() % 5 == 0 and 3 <= at.hour <= 17)
            key = at.isoformat().replace('+00:00','Z')
            observations[key] = {'fog':label,
                                 'cloud_base_ft': (5900 + d * 4) if hour in (2, 8, 14, 20) else None}
    return runs, observations


def test_issue_time_schema_and_no_peeking():
    init=datetime(2026,5,1,tzinfo=timezone.utc)
    data=fake_run(init,n=76)
    assert run_params(init)['run']=='2026-05-01T00:00'
    assert len(rows_from_data(data))==72
    r=rows_from_data(data)[1]
    assert r['features'].shape == (len(FEATURE_NAMES),)
    assert r['profile'].shape == (5,25)
    assert r['lead_hours']==1
    assert row_at(data,72) is None
    data['hourly']['cloud_cover_800hPa'][1] = None
    assert row_at(data,1) is None
    assert abs(uv(36,90)[0]+10)<1e-6
    # Optional GFS boundary-layer-height missing: keep row with explicit NaN.
    data['hourly']['boundary_layer_height'][2] = None
    assert np.isnan(row_at(data,2)['features'][7])
    assert len(list(run_times(init,init+timedelta(days=2))))==3
    with pytest.raises(ValueError):
        list(run_times(init,init,run_every_hours=3))


def test_metar_records_not_model_labels(tmp_path):
    csv_text='''# station data\nstation,valid,vsby,skyc1,skyl1,wxcodes\nBDU,2026-06-01 12:06,0.5,OVC,400,FG\nBDU,2026-06-01 13:05,10.0,CLR,M,\nBDU,2026-06-01 14:02,M,BKN,200,\nBDU,2026-06-01 15:01,2.0,CLR,M,\n'''
